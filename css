

body {
    background: #f4f4f4;
    padding: 20px;
}

header {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;

    text-align: center;
    margin-bottom: 20px;
    padding: 10px;

    border: 2px solid #333;
    border-radius: 10px;
    background: white;
}

header p {
    color: gray;
    margin-top: 5px;
}

.form-section {
    max-width: 500px;
    margin: auto;
    margin-bottom: 30px;
}

form {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

input, button {
    padding: 10px;
    font-size: 15px;
}

button {
    padding: 8px 18px;
    font-size: 14px;
    background: black;
    color: white;
    border: none;
    cursor: pointer;
    width: fit-content;
    align-self: center;
}

button:hover {
    background: #1d5fd3;
}

.student-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 15px;
}

.student-card {
    background: white;
    padding: 15px;
    border-radius: 8px;
    text-align: center;
}

.student-card h3 {
    margin-bottom: 8px;
}

.student-card p {
    margin-bottom: 10px;
}

.remove-btn {
    background: black;
}

.remove-btn:hover {
    background: darkred;
}

@media (max-width: 900px) {
    .student-grid {
        grid-template-columns: repeat(3, 1fr);
    }
}

@media (max-width: 600px) {
    .student-grid {
        grid-template-columns: 1fr;
    }
}
